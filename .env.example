# Smart Revenue Optimizer - local backend configuration
# Copy this file to backend/.env. Do not commit backend/.env.

# Database
# Leave DATABASE_URL unset to use the default local SQLite database.
# For MySQL, create the database first:
# CREATE DATABASE smart_revenue CHARACTER SET utf8mb4;
# Then uncomment and edit this URL (URL-encode special characters in passwords):
# DATABASE_URL=mysql+pymysql://root:yourpassword@localhost:3306/smart_revenue

# Store context (drives weather, holidays and local time)
STORE_CITY=Bengaluru
STORE_TIMEZONE=Asia/Kolkata
HOLIDAY_COUNTRY=IN
BASE_CURRENCY=INR

# Pricing and background behaviour
PRICE_REFRESH_SECONDS=120
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=300
SIGNAL_SIMULATOR_ENABLED=true
AUTO_TRAIN=true
TRAIN_SAMPLES=25000
SEED_HISTORY_HOURS=48

# Authentication
# If these are left commented, first startup creates admin / admin123
# and requires a password change at first login.
# To set your own credentials before first startup, uncomment both:
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=replace-with-a-strong-unique-password
#
# Optional: set a long, random signing key for stable deployments.
# If omitted, the backend generates and stores one in backend/.secret_key.
# SECRET_KEY=replace-with-a-long-random-secret
# TOKEN_EXPIRE_MINUTES=480

# Optional API-key authentication for POST /signals integrations.
# INGEST_API_KEY=replace-with-a-long-random-api-key

# Frontend/CORS (only change if your frontend runs on a different origin)
# CORS_ORIGINS=http://localhost:3000,http://localhost:3001
