
# Database 
# Default is a local SQLite file.For MySQL (as in the report):
# CREATE DATABASE smart_revenue CHARACTER SET utf8mb4;
# DATABASE_URL=mysql+pymysql://root:yourpassword@localhost:3306/smart_revenue

#Store context (drives live weather, holidays and local time) 
STORE_CITY=Bengaluru
STORE_TIMEZONE=Asia/Kolkata
HOLIDAY_COUNTRY=IN
BASE_CURRENCY=INR

# Behaviour 
PRICE_REFRESH_SECONDS=120        # a computed price is reused for this long
SCHEDULER_ENABLED=true           # background re-pricing loop
SCHEDULER_INTERVAL_SECONDS=300   # ...every 5 minutes
SIGNAL_SIMULATOR_ENABLED=true    # generate synthetic traffic + sales (turn off with real data)
AUTO_TRAIN=true                  # train the model on first start if none is saved
TRAIN_SAMPLES=25000
SEED_HISTORY_HOURS=48            # hours of demo history created on first run

# Login
ADMIN_USERNAME=admin1
ADMIN_PASSWORD=admin123


# Frontend/CORS
# CORS_ORIGINS=http://localhost:3000,http://localhost:3001
